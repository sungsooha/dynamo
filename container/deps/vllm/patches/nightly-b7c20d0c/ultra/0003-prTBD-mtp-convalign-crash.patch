+def preprocess_mamba_align_gpu(
+    *,
+    scheduler_output: SchedulerOutput,
+    kv_cache_config: KVCacheConfig,
+    cache_config: CacheConfig,
+    mamba_state_idx: dict[str, int],
+    input_batch: GPUInputBatch,
+    requests: dict[str, CachedRequestState],
+    forward_context: dict[str, Any],
+    mamba_state_copy_funcs: tuple[MambaStateCopyFunc, ...],
+    bufs: MambaBuffers,
+) -> None:
+    """GPU-side V1 align preprocess for spec-decode hybrid Mamba.
+
+    This mirrors ``preprocess_mamba``'s state-index bookkeeping, but routes the
+    actual block migration through the fused row-aware copy kernel. That is
+    required for DS conv layout when the previous step accepted a draft token:
+    the conv tail slice is non-contiguous and cannot be represented as one CPU
+    ``batch_memcpy`` entry.
+    """
+    ctx = bufs.postprocess_align
+    assert ctx is not None
+    assert ctx.mamba_state_idx_buf is not None
+    assert ctx.precopy_src_col_buf is not None
+    assert ctx.precopy_token_bias_buf is not None
+    assert cache_config.enable_prefix_caching
+
+    num_reqs = len(input_batch.req_ids)
+    if num_reqs == 0:
+        return
+
+    if not ctx.is_initialized:
+        ctx.initialize_from_forward_context(
+            kv_cache_config,
+            forward_context,
+            mamba_state_copy_funcs,
+            [
+                input_batch.block_table[gid].get_device_tensor(num_reqs)
+                for gid in ctx.mamba_group_ids
+            ],
+        )
+
+    mamba_spec = bufs.preprocess.mamba_spec
+    block_size = mamba_spec.block_size
+    num_speculative_blocks = mamba_spec.num_speculative_blocks
+    cleanup_mamba_state_idx(scheduler_output, mamba_state_idx)
+
+    state_idx_np = ctx.mamba_state_idx_buf.np
+    src_col_np = ctx.precopy_src_col_buf.np
+    token_bias_np = ctx.precopy_token_bias_buf.np
+    src_col_np[:num_reqs] = -1
+    token_bias_np[:num_reqs] = 0
+
+    for i, req_id in enumerate(input_batch.req_ids):
+        req_state = requests[req_id]
+        prev_state_idx = mamba_state_idx.get(req_id)
+        if prev_state_idx is None:
+            prev_state_idx = (req_state.num_computed_tokens - 1) // block_size
+
+        num_scheduled_tokens = scheduler_output.num_scheduled_tokens[req_id]
+        num_blocks = (
+            cdiv(req_state.num_computed_tokens + num_scheduled_tokens, block_size)
+            + num_speculative_blocks
+        )
+        curr_state_idx = num_blocks - 1 - num_speculative_blocks
+        mamba_state_idx[req_id] = curr_state_idx
+        state_idx_np[i] = curr_state_idx
+
+        if prev_state_idx != -1 and prev_state_idx != curr_state_idx:
+            src_col_np[i] = prev_state_idx
+            token_bias_np[i] = max(int(input_batch.num_accepted_tokens_cpu[i]) - 1, 0)
+            input_batch.num_accepted_tokens_cpu[i] = 1
+
+    ctx.mamba_state_idx_buf.copy_to_gpu(num_reqs)
+    ctx.precopy_src_col_buf.copy_to_gpu(num_reqs)
+    ctx.precopy_token_bias_buf.copy_to_gpu(num_reqs)
+    ctx.run_fused_precopy(
+        num_reqs=num_reqs,
+        state_idx_gpu=ctx.mamba_state_idx_buf.gpu,
+        src_col_gpu=ctx.precopy_src_col_buf.gpu,
+        token_bias_gpu=ctx.precopy_token_bias_buf.gpu,
+        idx_mapping=None,
+    )
+
